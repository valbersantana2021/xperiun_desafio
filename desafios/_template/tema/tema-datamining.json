{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.157.json",
  "name": "Tema DataMining - Dark",
  "dataColors": [
    "#00D4FF",
    "#8B5CF6",
    "#F4A261",
    "#34D399",
    "#FF7A8C",
    "#3B82F6",
    "#E879F9",
    "#94A3B8"
  ],
  "good": "#6BD69A",
  "neutral": "#F2B441",
  "bad": "#E5484D",
  "minimum": "#123B57",
  "center": "#0E7FA8",
  "maximum": "#00D4FF",
  "foreground": "#E2E8F0",
  "foregroundNeutralSecondary": "#CBD5E1",
  "foregroundNeutralTertiary": "#020611",
  "backgroundLight": "#112240",
  "backgroundNeutral": "#0D1A2E",
  "accent": "#00D4FF",
  "tableAccent": "#00D4FF",
  "textClasses": {
    "callout": {
      "fontSize": 32,
      "fontFace": "'Segoe UI Bold', wf_segoe-ui_bold, helvetica, arial, sans-serif",
      "color": "#FFFFFF"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
      "color": "#CBD5E1"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
      "color": "#E2E8F0"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
      "color": "#E2E8F0"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Top",
            "showTitle": false,
            "legendMarkerRendering": "lineAndMarker",
            "matchLineColor": true,
            "fontSize": 10,
            "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "labelColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            }
          }
        ],
        "title": [
          {
            "show": true,
            "alignment": "left",
            "fontSize": 13,
            "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "labels": [
          {
            "show": true,
            "labelOrientation": 0,
            "labelDisplayUnits": 0,
            "labelPrecision": 0,
            "enableBackground": false,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0D1A2E"
              }
            },
            "transparency": 100
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1B3350"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "angle": 0,
            "color": {
              "solid": {
                "color": "#000000"
              }
            },
            "position": "Outer",
            "preset": "Custom",
            "shadowBlur": 20,
            "shadowDistance": 8,
            "shadowSpread": 4,
            "transparency": 88
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "foreground": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "border": {
              "solid": {
                "color": "#1B3350"
              }
            },
            "background": {
              "solid": {
                "color": "#0D1A2E"
              }
            },
            "transparency": 4,
            "showVisualInformationButton": false,
            "showVisualWarningButton": false,
            "showVisualErrorButton": false,
            "showPinButton": false,
            "showFocusModeButton": true
          }
        ],
        "visualTooltip": [
          {
            "themedTitleFontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "themedValueFontColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "actionFontColor": {
              "solid": {
                "color": "#00D4FF"
              }
            },
            "themedBackground": {
              "solid": {
                "color": "#0D1A2E"
              }
            },
            "transparency": 6,
            "fontSize": 9
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "axisStyle": "showTitleOnly",
            "gridlineShow": false,
            "color": "#94A3B8",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif"
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "showAxisTitle": false,
            "labelDisplayUnits": 0,
            "labelPrecision": 0,
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            }
          }
        ],
        "padding": [
          {
            "top": 16,
            "right": 16,
            "bottom": 16,
            "left": 16
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#050B18"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#020611"
              }
            },
            "transparency": 0
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#0D1A2E"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "transparency": 10
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "backgroundColor": {
              "solid": {
                "color": "#0D1A2E"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#1B3350"
              }
            },
            "inputBoxColor": {
              "solid": {
                "color": "#050B18"
              }
            },
            "textSize": 9,
            "transparency": 10
          },
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#0D1A2E"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#1B3350"
              }
            },
            "inputBoxColor": {
              "solid": {
                "color": "#050B18"
              }
            },
            "textSize": 9,
            "transparency": 10
          }
        ],
        "pageSize": [
          {
            "pageSizeWidth": 1280,
            "pageSizeHeight": 720,
            "pageSizeTypes": "Widescreen"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#00D4FF"
              }
            },
            "fontSize": 28,
            "fontFamily": "'Segoe UI Bold', wf_segoe-ui_bold, helvetica, arial, sans-serif",
            "labelDisplayUnits": 0,
            "labelPrecision": 0
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "$id": "default",
            "fontColor": {
              "solid": {
                "color": "#00D4FF"
              }
            },
            "fontSize": 28,
            "fontFamily": "'Segoe UI Bold', wf_segoe-ui_bold, helvetica, arial, sans-serif",
            "horizontalAlignment": "center"
          }
        ],
        "label": [
          {
            "$id": "default",
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "fontSize": 10,
            "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "position": "belowValue",
            "horizontalAlignment": "center"
          }
        ],
        "fillCustom": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#0D1A2E"
              }
            },
            "transparency": 0
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": false
          }
        ],
        "shadowCustom": [
          {
            "$id": "default",
            "show": false
          }
        ],
        "accentBar": [
          {
            "$id": "default",
            "show": false
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0D1A2E"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "kpi": {
      "*": {
        "indicator": [
          {
            "fontSize": 28,
            "fontFamily": "'Segoe UI Bold', wf_segoe-ui_bold, helvetica, arial, sans-serif"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "header": [
          {
            "textSize": 9
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "items": [
          {
            "outlineStyle": 0,
            "padding": 2,
            "background": {
              "solid": {
                "color": "#0D1A2E"
              }
            },
            "textSize": 9,
            "fontColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            }
          }
        ],
        "padding": [
          {
            "top": 0,
            "right": 0,
            "bottom": 0,
            "left": 0
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "stylePreset": [
          {
            "name": "Minimal"
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#1B3350"
              }
            },
            "gridHorizontalWeight": 1,
            "rowPadding": 4,
            "outlineColor": {
              "solid": {
                "color": "#1B3350"
              }
            },
            "outlineWeight": 1,
            "textSize": 10
          }
        ],
        "values": [
          {
            "backColor": {
              "solid": {
                "color": "#0D1A2E"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#0D1A2E"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#080F20"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#0D1A2E"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "stylePreset": [
          {
            "name": "Minimal"
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#1B3350"
              }
            },
            "gridHorizontalWeight": 1,
            "rowPadding": 4,
            "outlineColor": {
              "solid": {
                "color": "#1B3350"
              }
            },
            "outlineWeight": 1,
            "textSize": 10
          }
        ],
        "values": [
          {
            "backColor": {
              "solid": {
                "color": "#0D1A2E"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#0D1A2E"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#080F20"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#0D1A2E"
              }
            }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "text": [
          {
            "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
            "fontSize": 16
          }
        ],
        "padding": [
          {
            "top": 2,
            "right": 0,
            "bottom": 0,
            "left": 16
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "padding": [
          {
            "top": 0,
            "right": 0,
            "bottom": 0,
            "left": 0
          }
        ],
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#0D1A2E"
              }
            },
            "transparency": 0
          },
          {
            "$id": "hover",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#16294A"
              }
            },
            "transparency": 0
          },
          {
            "$id": "selected",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#143945"
              }
            },
            "transparency": 0
          }
        ],
        "text": [
          {
            "$id": "default",
            "fontColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "bold": false
          },
          {
            "$id": "hover",
            "fontColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "bold": false
          },
          {
            "$id": "selected",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "bold": true
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": false
          }
        ],
        "accentBar": [
          {
            "$id": "default",
            "show": false
          },
          {
            "$id": "selected",
            "show": true,
            "color": {
              "solid": {
                "color": "#00D4FF"
              }
            },
            "position": "Left",
            "width": 3
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "padding": [
          {
            "top": 0,
            "right": 0,
            "bottom": 0,
            "left": 0
          }
        ],
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#0D1A2E"
              }
            },
            "transparency": 0
          },
          {
            "$id": "hover",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#16294A"
              }
            },
            "transparency": 0
          },
          {
            "$id": "selected",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#143945"
              }
            },
            "transparency": 0
          }
        ],
        "text": [
          {
            "$id": "default",
            "fontColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "bold": false
          },
          {
            "$id": "hover",
            "fontColor": {
              "solid": {
                "color": "#00D4FF"
              }
            },
            "bold": false
          },
          {
            "$id": "selected",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "bold": false
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "gridlineShow": false,
            "labelDisplayUnits": 0,
            "labelPrecision": 0,
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "gridlineShow": false,
            "labelDisplayUnits": 0,
            "labelPrecision": 0,
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            }
          }
        ]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "gridlineShow": false,
            "labelDisplayUnits": 0,
            "labelPrecision": 0,
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "secShow": true
          }
        ]
      }
    },
    "lineStackedColumnComboChart": {
      "*": {
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "gridlineShow": false,
            "labelDisplayUnits": 0,
            "labelPrecision": 0,
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "secShow": true
          }
        ]
      }
    }
