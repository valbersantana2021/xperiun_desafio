model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["fVendas","dProduto","dGeografia","dSegmento","dCalendario","caminhoDados","stgVendas"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table fVendas
ref table dProduto
ref table dGeografia
ref table dSegmento
ref table dCalendario
ref table Medidas

